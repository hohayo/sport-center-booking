{
  "manifest_version": 3,
  "name": "運動中心預約外掛",
  "version": "0.1.0",
  "description": "選日期、場地、時段，協助預約運動中心場地。需要授權碼。",
  "author": "Kyle, Chuang",
  "permissions": ["storage"],
  "host_permissions": ["https://*.supabase.co/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": { "default_title": "運動中心預約外掛：授權設定" },
  "content_scripts": [
    {
      "matches": [
        "https://bymca.xuanen.com.tw/ymca01.aspx*",
        "https://scr.cyc.org.tw/tp25.aspx*",
        "https://www.cjcf.com.tw/CG02.aspx*",
        "https://bwd.xuanen.com.tw/wd27.aspx*",
        "https://fe.xuanen.com.tw/fe01.aspx*",
        "https://fe.xuanen.com.tw/fe03.aspx*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
